# ===========================================
# N8N Docker Compose 환경 변수 설정
# ===========================================
# 이 파일에는 사용자가 반드시 변경해야 하거나
# 환경에 따라 자주 변경되는 변수만 포함됩니다.
# ===========================================

# -------------------------------------------
# N8N 기본 설정
# -------------------------------------------

# N8N 웹 인터페이스 접속 포트
# 외부에서 접근할 때 사용하는 포트 번호
N8N_PORT=5678

# N8N 프로토콜 (http 또는 https)
# SSL/TLS 인증서 사용 시 https로 변경
N8N_PROTOCOL=http

# -------------------------------------------
# N8N 인증 설정
# -------------------------------------------

# Basic Auth 활성화 여부 (true/false)
# 웹 인터페이스 접근 시 기본 인증 사용
N8N_BASIC_AUTH_ACTIVE=true

# Basic Auth 사용자명 (필수 변경)
N8N_BASIC_AUTH_USER=your_username

# Basic Auth 비밀번호 (필수 변경 - 강력한 비밀번호 사용)
N8N_BASIC_AUTH_PASSWORD=your_secure_password

# -------------------------------------------
# N8N 웹훅 및 보안 설정
# -------------------------------------------

# 외부에서 웹훅 호출 시 사용할 URL (필수 변경)
# 예: https://your-domain.com/ 또는 http://your-server-ip:5678/
WEBHOOK_URL=http://<your_server_ip_or_domain>:5678/

# 워크플로우 데이터 암호화 키 (필수 변경)
# 최초 설정 후 변경하면 기존 암호화 데이터를 복호화할 수 없음
# 안전한 랜덤 문자열 사용 권장 (예: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=your_secret_encryption_key

# -------------------------------------------
# 시간대 설정
# -------------------------------------------

# 시스템 시간대 (스케줄 트리거 등에 영향)
# 한국: Asia/Seoul, 일본: Asia/Tokyo, UTC 등
GENERIC_TIMEZONE=Asia/Seoul

# -------------------------------------------
# PostgreSQL 데이터베이스 설정
# -------------------------------------------

# PostgreSQL 관리자 계정 (컨테이너 초기화 시 사용)
POSTGRES_USER=n8n_user

# PostgreSQL 관리자 비밀번호 (필수 변경 - 강력한 비밀번호 사용)
POSTGRES_PASSWORD=your_db_password

# PostgreSQL 데이터베이스 이름
POSTGRES_DB=n8n

# N8N이 사용할 PostgreSQL 계정 (관리자와 동일하게 설정 가능)
POSTGRES_NON_ROOT_USER=n8n_user

# N8N이 사용할 PostgreSQL 비밀번호 (필수 변경)
POSTGRES_NON_ROOT_PASSWORD=your_db_password
